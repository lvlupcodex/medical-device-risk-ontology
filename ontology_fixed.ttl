#################################################################
# EXPLICIT INCIDENT-FSCA LINKS
# Comentario:
# Aunque addressesIncident tiene inverseOf hasCorrectiveAction,
# estas tripletas facilitan la visualización en Protégé/WebVOWL
# y activan la regla SWRL de CorrectedIncident.
#################################################################

:INC-001 :hasCorrectiveAction :FSCA-001 .
:INC-002 :hasCorrectiveAction :FSCA-002 .
:INC-003 :hasCorrectiveAction :FSCA-003 .
:INC-011 :hasCorrectiveAction :FSCA-009 .
:INC-012 :hasCorrectiveAction :FSCA-010 .

#################################################################
# SWRL VARIABLES
#################################################################

:var_d rdf:type swrl:Variable .
:var_i rdf:type swrl:Variable .
:var_f rdf:type swrl:Variable .

#################################################################
# SWRL RULE 1 - If a MedicalDevice has isIVD true, infer IVDDevice.
#################################################################

:Rule_IVD_Device
    rdf:type swrl:Imp ;
    rdfs:label "Infer IVD device from isIVD true"@en ;
    rdfs:comment "SWRL rule: MedicalDevice(?d) and isIVD(?d,true) imply IVDDevice(?d)."@en ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :MedicalDevice ;
            swrl:argument1 :var_d ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :isIVD ;
                swrl:argument1 :var_d ;
                swrl:argument2 [ rdf:type swrl:DataObject ; swrl:value "true"^^xsd:boolean ] ] ;
            rdf:rest rdf:nil ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :IVDDevice ;
            swrl:argument1 :var_d ] ;
        rdf:rest rdf:nil ] .

#################################################################
# SWRL RULE 2 - If a MedicalDevice has isIVD false, infer MDRDevice.
#################################################################

:Rule_MDR_Device
    rdf:type swrl:Imp ;
    rdfs:label "Infer MDR device from isIVD false"@en ;
    rdfs:comment "SWRL rule: MedicalDevice(?d) and isIVD(?d,false) imply MDRDevice(?d)."@en ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :MedicalDevice ;
            swrl:argument1 :var_d ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :isIVD ;
                swrl:argument1 :var_d ;
                swrl:argument2 [ rdf:type swrl:DataObject ; swrl:value "false"^^xsd:boolean ] ] ;
            rdf:rest rdf:nil ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :MDRDevice ;
            swrl:argument1 :var_d ] ;
        rdf:rest rdf:nil ] .

#################################################################
# SWRL RULE 3 - If an Incident has a corrective action, infer CorrectedIncident.
#################################################################

:Rule_Corrected_Incident
    rdf:type swrl:Imp ;
    rdfs:label "Infer corrected incident from corrective action"@en ;
    rdfs:comment "SWRL rule: Incident(?i) and hasCorrectiveAction(?i,?f) imply CorrectedIncident(?i)."@en ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Incident ;
            swrl:argument1 :var_i ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                swrl:propertyPredicate :hasCorrectiveAction ;
                swrl:argument1 :var_i ;
                swrl:argument2 :var_f ] ;
            rdf:rest rdf:nil ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :CorrectedIncident ;
            swrl:argument1 :var_i ] ;
        rdf:rest rdf:nil ] .
