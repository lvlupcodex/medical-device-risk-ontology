    </owl:NamedIndividual>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ClassD -->


    <owl:NamedIndividual rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ClassD">
