    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ClassB -->


    <owl:NamedIndividual rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ClassB">
        <rdf:type rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskClass"/>
        <rdfs:comment xml:lang="en">IVDR risk class B.</rdfs:comment>
        <rdfs:label xml:lang="en">Class B</rdfs:label>
        <skos:prefLabel xml:lang="en">Class B</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ClassC -->


    <owl:NamedIndividual rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ClassC">
        <rdf:type rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskClass"/>
        <rdfs:comment xml:lang="en">IVDR risk class C.</rdfs:comment>
