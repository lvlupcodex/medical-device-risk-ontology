        <rdfs:comment xml:lang="en">MDR risk class IIb.</rdfs:comment>
        <rdfs:label xml:lang="en">Class IIb</rdfs:label>
        <skos:prefLabel xml:lang="en">Class IIb</skos:prefLabel>
