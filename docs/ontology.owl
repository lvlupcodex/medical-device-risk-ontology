        <rdfs:label xml:lang="en">Class I</rdfs:label>
        <skos:prefLabel xml:lang="en">Class I</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ClassIII -->


    <owl:NamedIndividual rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ClassIII">
