<?xml version="1.0"?>
<rdf:RDF xmlns="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#"
     xml:base="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:ontology="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#">
    <owl:Ontology rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-20</terms:created>
        <terms:creator xml:lang="en">lvlupcodex</terms:creator>
        <terms:description xml:lang="en">EN: Ontology for representing medical devices, manufacturers, risks, incidents and field safety corrective actions under MDR and IVDR.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">Medical Device Risk Ontology</terms:title>
        <rdfs:comment xml:lang="en">This ontology models a European-style catalogue of medical devices, manufacturers, IMDRF risks, reported incidents and field safety corrective actions. It is designed as an application ontology for the PEC2 assignment.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical Device Risk Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#hasRuleText -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#hasRuleText"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://xmlns.com/foaf/0.1/mbox -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/mbox"/>
    


    <!-- http://xmlns.com/foaf/0.1/name -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#addressesIncident -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#addressesIncident">
        <owl:inverseOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasCorrectiveAction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:comment xml:lang="en">Relates a field safety corrective action to the incident it addresses.</rdfs:comment>
        <rdfs:label xml:lang="en">addresses incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#concernsDevice -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#concernsDevice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:comment xml:lang="en">Relates an incident to the device involved in the event.</rdfs:comment>
        <rdfs:label xml:lang="en">concerns device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasActionStatus -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasActionStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActionStatus"/>
        <rdfs:comment xml:lang="en">Relates a field safety corrective action to its current status.</rdfs:comment>
        <rdfs:label xml:lang="en">has action status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasCompetentAuthority -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasCompetentAuthority">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CompetentAuthority"/>
        <rdfs:comment xml:lang="en">Relates a manufacturer to the competent authority responsible for oversight.</rdfs:comment>
        <rdfs:label xml:lang="en">has competent authority</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasCorrectiveAction -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasCorrectiveAction">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:comment xml:lang="en">Relates an incident to a field safety corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">has corrective action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasIncident -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasIncident">
        <owl:inverseOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#concernsDevice"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:comment xml:lang="en">Relates a medical device to an incident reported for it.</rdfs:comment>
        <rdfs:label xml:lang="en">has incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasManufacturer -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasManufacturer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
        <rdfs:comment xml:lang="en">Relates a medical device to the manufacturer responsible for it.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasManufacturerCountry -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasManufacturerCountry">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Country"/>
        <rdfs:comment xml:lang="en">Relates a manufacturer to its country.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer country</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasProbability -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasProbability">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ProbabilityLevel"/>
        <rdfs:comment xml:lang="en">Relates a risk to its probability level.</rdfs:comment>
        <rdfs:label xml:lang="en">has probability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasRiskClass -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasRiskClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskClass"/>
        <rdfs:comment xml:lang="en">Relates a device to its regulatory risk class.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasSeverity -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasSeverity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SeverityLevel"/>
        <rdfs:comment xml:lang="en">Relates a risk to its severity level.</rdfs:comment>
        <rdfs:label xml:lang="en">has severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#involvesRisk -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#involvesRisk">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Relates an incident to the risk involved in the event.</rdfs:comment>
        <rdfs:label xml:lang="en">involves risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#manufacturesDevice -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#manufacturesDevice">
        <owl:inverseOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasManufacturer"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:comment xml:lang="en">Relates a manufacturer to a medical device manufactured by it.</rdfs:comment>
        <rdfs:label xml:lang="en">manufactures device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#regulatedUnder -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#regulatedUnder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RegulatoryFramework"/>
        <rdfs:comment xml:lang="en">Relates a device to the regulatory framework under which it is registered.</rdfs:comment>
        <rdfs:label xml:lang="en">regulated under</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#reportedBy -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#reportedBy">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
        <rdfs:comment xml:lang="en">Relates an incident to the reporting manufacturer or entity.</rdfs:comment>
        <rdfs:label xml:lang="en">reported by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#reportedInCountry -->


    <owl:ObjectProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#reportedInCountry">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Country"/>
        <rdfs:comment xml:lang="en">Relates an incident to the country where it was reported.</rdfs:comment>
        <rdfs:label xml:lang="en">reported in country</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#actionDate -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#actionDate">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the field safety corrective action started.</rdfs:comment>
        <rdfs:label xml:lang="en">action date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#authorizationNumber -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#authorizationNumber">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Manufacturer authorization number.</rdfs:comment>
        <rdfs:label xml:lang="en">authorization number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#closureDate -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#closureDate">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the field safety corrective action was closed, when available.</rdfs:comment>
        <rdfs:label xml:lang="en">closure date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#contactEmail -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#contactEmail">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Regulatory contact email of the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">contact email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#correctiveActionTaken -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#correctiveActionTaken">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean value indicating whether a corrective action was taken for the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">corrective action taken</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#countriesAffected -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#countriesAffected">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Textual description of the countries affected by the field safety corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">countries affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#detectionDate -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#detectionDate">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the incident was detected.</rdfs:comment>
        <rdfs:label xml:lang="en">detection date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#deviceName -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#deviceName">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Literal name of the medical device.</rdfs:comment>
        <rdfs:label xml:lang="en">device name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#devicesAffected -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#devicesAffected">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Number or description of devices affected by the field safety corrective action. It is modelled as string because some CSV values include units such as tests.</rdfs:comment>
        <rdfs:label xml:lang="en">devices affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eudamedFscaReference -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eudamedFscaReference">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">EUDAMED-like reference identifier for the field safety corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED FSCA reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eudamedIncidentReference -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eudamedIncidentReference">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">EUDAMED-like reference identifier for the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED incident reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eudamedSrn -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eudamedSrn">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Single Registration Number used in EUDAMED-like contexts.</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED SRN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eventDate -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eventDate">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the incident occurred.</rdfs:comment>
        <rdfs:label xml:lang="en">event date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#fscaDescription -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#fscaDescription">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Textual description of the field safety corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">FSCA description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#imdrfCode -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#imdrfCode">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">IMDRF-inspired risk code.</rdfs:comment>
        <rdfs:label xml:lang="en">IMDRF code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#incidentDescription -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#incidentDescription">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Textual description of the reported incident.</rdfs:comment>
        <rdfs:label xml:lang="en">incident description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#intendedPurpose -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#intendedPurpose">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Intended medical purpose of the device.</rdfs:comment>
        <rdfs:label xml:lang="en">intended purpose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isActive -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isActive">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean value indicating whether the device is active.</rdfs:comment>
        <rdfs:label xml:lang="en">is active</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isIVD -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isIVD">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean value indicating whether the device is an in vitro diagnostic device.</rdfs:comment>
        <rdfs:label xml:lang="en">is IVD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isImplantable -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isImplantable">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean value indicating whether the device is implantable.</rdfs:comment>
        <rdfs:label xml:lang="en">is implantable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isReusable -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isReusable">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean value indicating whether the device is reusable.</rdfs:comment>
        <rdfs:label xml:lang="en">is reusable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#manufacturerName -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#manufacturerName">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturer name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#outcome -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#outcome">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Clinical, technical or regulatory outcome reported for an incident.</rdfs:comment>
        <rdfs:label xml:lang="en">outcome</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#patientAge -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#patientAge">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Age of the patient involved in the incident, when available.</rdfs:comment>
        <rdfs:label xml:lang="en">patient age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#patientSex -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#patientSex">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Sex of the patient involved in the incident, when available.</rdfs:comment>
        <rdfs:label xml:lang="en">patient sex</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#reportDate -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#reportDate">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which the incident was reported.</rdfs:comment>
        <rdfs:label xml:lang="en">report date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#riskName -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#riskName">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Human-readable name of the risk.</rdfs:comment>
        <rdfs:label xml:lang="en">risk name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#scope -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#scope">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Scope of the field safety corrective action, such as affected lots, models or versions.</rdfs:comment>
        <rdfs:label xml:lang="en">scope</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#udiDi -->


    <owl:DatatypeProperty rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#udiDi">
        <rdfs:domain rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique Device Identification Device Identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">UDI-DI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://schema.org/MedicalDevice -->


    <owl:Class rdf:about="http://schema.org/MedicalDevice">
        <rdfs:comment xml:lang="en">External class from schema.org representing a medical device. Used as superclass of the local MedicalDevice class.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2003/11/swrl#Imp -->


    <owl:Class rdf:about="http://www.w3.org/2003/11/swrl#Imp">
        <rdfs:comment xml:lang="en">SWRL vocabulary class representing an implication rule. Declared here to satisfy OWL class typing requirements.</rdfs:comment>
        <rdfs:label xml:lang="en">SWRL Implication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
        <rdfs:comment xml:lang="en">External class from SKOS representing a concept in a controlled vocabulary. Used as superclass of ControlledVocabularyConcept.</rdfs:comment>
        <rdfs:label xml:lang="en">Concept</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Agent -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
        <rdfs:comment xml:lang="en">External class from PROV-O representing an agent that can act. Used as superclass of the local CompetentAuthority class.</rdfs:comment>
        <rdfs:label xml:lang="en">Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Organization -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization">
        <rdfs:comment xml:lang="en">External class from FOAF representing an organization. Used as superclass of the local Manufacturer class.</rdfs:comment>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActionStatus -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActionStatus">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept"/>
        <rdfs:comment xml:lang="en">Controlled concept describing whether a field safety corrective action is open or closed.</rdfs:comment>
        <rdfs:label xml:lang="en">Action status</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActiveDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActiveDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:comment xml:lang="en">A device that depends on a source of energy for its operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Active device</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActiveImplant -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActiveImplant">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActiveDevice"/>
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ImplantableDevice"/>
        <rdfs:comment xml:lang="en">An implantable device that depends on a source of energy for its operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Active implant</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CompetentAuthority -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CompetentAuthority">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity"/>
        <rdfs:comment xml:lang="en">Regulatory authority responsible for medical device oversight in a country.</rdfs:comment>
        <rdfs:label xml:lang="en">Competent authority</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ContaminationRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ContaminationRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to contamination of reagents or medical products.</rdfs:comment>
        <rdfs:label xml:lang="en">Contamination risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity"/>
        <rdfs:comment xml:lang="en">A controlled concept used to normalize categorical values from the CSV files.</rdfs:comment>
        <rdfs:label xml:lang="en">Controlled vocabulary concept</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CorrectedIncident -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CorrectedIncident">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:comment xml:lang="en">An incident for which a corrective action has been taken or is associated.</rdfs:comment>
        <rdfs:label xml:lang="en">Corrected incident</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Country -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Country">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept"/>
        <rdfs:comment xml:lang="en">Country related to a manufacturer, reported incident or corrective action scope.</rdfs:comment>
        <rdfs:label xml:lang="en">Country</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CybersecurityRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CybersecurityRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to exploitable cybersecurity vulnerabilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Cybersecurity risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#DiagnosticRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#DiagnosticRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to incorrect diagnostic results.</rdfs:comment>
        <rdfs:label xml:lang="en">Diagnostic risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#addressesIncident"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A field safety corrective action, such as a recall, safety alert, user notice or in-situ correction, associated with an incident.</rdfs:comment>
        <rdfs:label xml:lang="en">Field safety corrective action</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#IVDDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#IVDDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <owl:disjointWith rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MDRDevice"/>
        <rdfs:comment xml:lang="en">An in vitro diagnostic medical device regulated under the In Vitro Diagnostic Regulation.</rdfs:comment>
        <rdfs:label xml:lang="en">IVD device</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ImplantableActiveDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ImplantableActiveDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActiveDevice"/>
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ImplantableDevice"/>
        <rdfs:comment xml:lang="en">A device that is both implantable and active.</rdfs:comment>
        <rdfs:label xml:lang="en">Implantable active device</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ImplantableDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ImplantableDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:comment xml:lang="en">A device intended to be totally or partially introduced into the human body.</rdfs:comment>
        <rdfs:label xml:lang="en">Implantable device</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/resource/Implant_(medicine)"/>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InSituCorrection -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InSituCorrection">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:comment xml:lang="en">A corrective action performed in the field without removing the device from use.</rdfs:comment>
        <rdfs:label xml:lang="en">In-situ correction</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InVitroDiagnosticDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InVitroDiagnosticDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#IVDDevice"/>
        <rdfs:comment xml:lang="en">A device intended for the examination of specimens derived from the human body for diagnostic purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">In vitro diagnostic device</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#concernsDevice"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#involvesRisk"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A reported event associated with a medical device, a risk and an outcome.</rdfs:comment>
        <rdfs:label xml:lang="en">Incident</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InfectionRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InfectionRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to infection associated with a device.</rdfs:comment>
        <rdfs:label xml:lang="en">Infection risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InjuryRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InjuryRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to patient injury or harm.</rdfs:comment>
        <rdfs:label xml:lang="en">Injury risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InterferenceRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InterferenceRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to electromagnetic or imaging interference.</rdfs:comment>
        <rdfs:label xml:lang="en">Interference risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MDRDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MDRDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:comment xml:lang="en">A medical device regulated under the Medical Device Regulation.</rdfs:comment>
        <rdfs:label xml:lang="en">MDR device</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MalfunctionRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MalfunctionRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to device malfunction or failure.</rdfs:comment>
        <rdfs:label xml:lang="en">Malfunction risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasManufacturerCountry"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Country"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An organization responsible for manufacturing or placing a medical device on the market.</rdfs:comment>
        <rdfs:label xml:lang="en">Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MaterialRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MaterialRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to material wear, corrosion, particles or toxicity.</rdfs:comment>
        <rdfs:label xml:lang="en">Material risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice">
        <rdfs:subClassOf rdf:resource="http://schema.org/MedicalDevice"/>
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasManufacturer"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasRiskClass"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskClass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#regulatedUnder"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RegulatoryFramework"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A medical device or in vitro diagnostic device represented in the catalogue and regulated under MDR or IVDR.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical device</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://schema.org/MedicalDevice"/>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/resource/Medical_device"/>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity">
        <rdfs:comment xml:lang="en">Root class for all local entities defined in the medical device risk ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical device risk entity</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#NearMissIncident -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#NearMissIncident">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <owl:disjointWith rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SeriousIncident"/>
        <rdfs:comment xml:lang="en">An incident that did not result in harm but could have led to an adverse outcome.</rdfs:comment>
        <rdfs:label xml:lang="en">Near-miss incident</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#PacemakerDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#PacemakerDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActiveImplant"/>
        <rdfs:comment xml:lang="en">An active implantable device used for cardiac pacing.</rdfs:comment>
        <rdfs:label xml:lang="en">Pacemaker device</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/resource/Artificial_cardiac_pacemaker"/>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ProbabilityLevel -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ProbabilityLevel">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept"/>
        <rdfs:comment xml:lang="en">Controlled concept describing the probability of a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">Probability level</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RadiationRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RadiationRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to unintended or excessive radiation exposure.</rdfs:comment>
        <rdfs:label xml:lang="en">Radiation risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Recall -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Recall">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:comment xml:lang="en">A field safety corrective action involving removal, replacement or recall of affected devices.</rdfs:comment>
        <rdfs:label xml:lang="en">Recall</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RegulatoryFramework -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RegulatoryFramework">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept"/>
        <rdfs:comment xml:lang="en">Regulatory framework applicable to a device, such as MDR or IVDR.</rdfs:comment>
        <rdfs:label xml:lang="en">Regulatory framework</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ReusableDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ReusableDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:comment xml:lang="en">A device designed to be reused after appropriate reprocessing or maintenance.</rdfs:comment>
        <rdfs:label xml:lang="en">Reusable device</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasProbability"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ProbabilityLevel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasSeverity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SeverityLevel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A risk identified for a medical device according to a controlled risk terminology, such as IMDRF-inspired coding.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskCategory -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskCategory">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept"/>
        <rdfs:comment xml:lang="en">High-level category used to group risks, such as Device Failure or Patient Harm.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk category</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskClass -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskClass">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept"/>
        <rdfs:comment xml:lang="en">Regulatory risk class assigned to a device under MDR or IVDR.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk class</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskType -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskType">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept"/>
        <rdfs:comment xml:lang="en">Specific type of risk, such as MalfunctionRisk, InjuryRisk or DiagnosticRisk.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk type</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SafetyAlert -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SafetyAlert">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:comment xml:lang="en">A field safety corrective action based on a safety communication or alert.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety alert</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SelfTestDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SelfTestDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#IVDDevice"/>
        <rdfs:comment xml:lang="en">An in vitro diagnostic device intended to be used by lay persons or patients.</rdfs:comment>
        <rdfs:label xml:lang="en">Self-test device</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SeriousIncident -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SeriousIncident">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident"/>
        <rdfs:comment xml:lang="en">An incident that resulted, might have resulted or may result in serious patient harm or device malfunction.</rdfs:comment>
        <rdfs:label xml:lang="en">Serious incident</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SeverityLevel -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SeverityLevel">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept"/>
        <rdfs:comment xml:lang="en">Controlled concept describing the severity of a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">Severity level</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SingleUseDevice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SingleUseDevice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice"/>
        <rdfs:comment xml:lang="en">A device intended to be used once and not reprocessed for reuse.</rdfs:comment>
        <rdfs:label xml:lang="en">Single-use device</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SoftwareRisk -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SoftwareRisk">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to software malfunction or incorrect software behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">Software risk</rdfs:label>
    </owl:Class>
    


    <!-- https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#UserNotice -->


    <owl:Class rdf:about="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#UserNotice">
        <rdfs:subClassOf rdf:resource="https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:comment xml:lang="en">A notice issued to users or healthcare professionals about safe use of a device.</rdfs:comment>
        <rdfs:label xml:lang="en">User notice</rdfs:label>
    </owl:Class>
    


