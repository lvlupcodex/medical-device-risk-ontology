 ] .

#################################################################
#    Rules
#################################################################

[ rdfs:comment "SWRL rule: Incident(?i) and hasCorrectiveAction(?i,?f) imply CorrectedIncident(?i)."@en ;
   rdfs:label "Infer corrected incident from corrective action"@en ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> rdf:nil ;
   <http://www.w3.org/2003/11/swrl#head> rdf:nil
 ] .

[ rdfs:comment "SWRL rule: MedicalDevice(?d) and regulatedUnder(?d, IVDR) imply IVDDevice(?d)."@en ;
   rdfs:label "Infer IVD device from IVDR framework"@en ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> rdf:nil ;
   <http://www.w3.org/2003/11/swrl#head> rdf:nil
 ] .

[ rdfs:comment "SWRL rule: MedicalDevice(?d) and regulatedUnder(?d, MDR) imply MDRDevice(?d)."@en ;
   rdfs:label "Infer MDR device from MDR framework"@en ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> rdf:nil ;
   <http://www.w3.org/2003/11/swrl#head> rdf:nil
 ] .

