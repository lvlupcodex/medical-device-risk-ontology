@prefix : <https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#> .

<https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#> rdf:type owl:Ontology ;
                                                                       <http://purl.org/dc/terms/created> "2026-04-20"^^xsd:date ;
                                                                       <http://purl.org/dc/terms/creator> "lvlupcodex"@en ;
                                                                       <http://purl.org/dc/terms/description> "EN: Ontology for representing medical devices, manufacturers, risks, incidents and field safety corrective actions under MDR and IVDR."@en ;
                                                                       <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                                       <http://purl.org/dc/terms/title> "Medical Device Risk Ontology"@en ;
                                                                       rdfs:comment "This ontology models a European-style catalogue of medical devices, manufacturers, IMDRF risks, reported incidents and field safety corrective actions. It is designed as an application ontology for the PEC2 assignment."@en ;
                                                                       rdfs:label "Medical Device Risk Ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#hasRuleText
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#hasRuleText> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/mbox
<http://xmlns.com/foaf/0.1/mbox> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
<http://xmlns.com/foaf/0.1/name> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#addressesIncident
:addressesIncident rdf:type owl:ObjectProperty ;
                   owl:inverseOf :hasCorrectiveAction ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain :FieldSafetyCorrectiveAction ;
                   rdfs:range :Incident ;
                   rdfs:comment "Relates a field safety corrective action to the incident it addresses."@en ;
                   rdfs:label "addresses incident"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#concernsDevice
:concernsDevice rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Incident ;
                rdfs:range :MedicalDevice ;
                rdfs:comment "Relates an incident to the device involved in the event."@en ;
                rdfs:label "concerns device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasActionStatus
:hasActionStatus rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :FieldSafetyCorrectiveAction ;
                 rdfs:range :ActionStatus ;
                 rdfs:comment "Relates a field safety corrective action to its current status."@en ;
                 rdfs:label "has action status"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasCompetentAuthority
:hasCompetentAuthority rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :Manufacturer ;
                       rdfs:range :CompetentAuthority ;
                       rdfs:comment "Relates a manufacturer to the competent authority responsible for oversight."@en ;
                       rdfs:label "has competent authority"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasCorrectiveAction
:hasCorrectiveAction rdf:type owl:ObjectProperty ;
                     rdfs:domain :Incident ;
                     rdfs:range :FieldSafetyCorrectiveAction ;
                     rdfs:comment "Relates an incident to a field safety corrective action."@en ;
                     rdfs:label "has corrective action"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasIncident
:hasIncident rdf:type owl:ObjectProperty ;
             owl:inverseOf :concernsDevice ;
             rdfs:domain :MedicalDevice ;
             rdfs:range :Incident ;
             rdfs:comment "Relates a medical device to an incident reported for it."@en ;
             rdfs:label "has incident"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasManufacturer
:hasManufacturer rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :MedicalDevice ;
                 rdfs:range :Manufacturer ;
                 rdfs:comment "Relates a medical device to the manufacturer responsible for it."@en ;
                 rdfs:label "has manufacturer"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasManufacturerCountry
:hasManufacturerCountry rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :Manufacturer ;
                        rdfs:range :Country ;
                        rdfs:comment "Relates a manufacturer to its country."@en ;
                        rdfs:label "has manufacturer country"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasProbability
:hasProbability rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Risk ;
                rdfs:range :ProbabilityLevel ;
                rdfs:comment "Relates a risk to its probability level."@en ;
                rdfs:label "has probability"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasRiskClass
:hasRiskClass rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :MedicalDevice ;
              rdfs:range :RiskClass ;
              rdfs:comment "Relates a device to its regulatory risk class."@en ;
              rdfs:label "has risk class"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#hasSeverity
:hasSeverity rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Risk ;
             rdfs:range :SeverityLevel ;
             rdfs:comment "Relates a risk to its severity level."@en ;
             rdfs:label "has severity"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#involvesRisk
:involvesRisk rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Incident ;
              rdfs:range :Risk ;
              rdfs:comment "Relates an incident to the risk involved in the event."@en ;
              rdfs:label "involves risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#manufacturesDevice
:manufacturesDevice rdf:type owl:ObjectProperty ;
                    owl:inverseOf :hasManufacturer ;
                    rdfs:domain :Manufacturer ;
                    rdfs:range :MedicalDevice ;
                    rdfs:comment "Relates a manufacturer to a medical device manufactured by it."@en ;
                    rdfs:label "manufactures device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#regulatedUnder
:regulatedUnder rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :MedicalDevice ;
                rdfs:range :RegulatoryFramework ;
                rdfs:comment "Relates a device to the regulatory framework under which it is registered."@en ;
                rdfs:label "regulated under"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#reportedBy
:reportedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Incident ;
            rdfs:range :Manufacturer ;
            rdfs:comment "Relates an incident to the reporting manufacturer or entity."@en ;
            rdfs:label "reported by"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#reportedInCountry
:reportedInCountry rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Incident ;
                   rdfs:range :Country ;
                   rdfs:comment "Relates an incident to the country where it was reported."@en ;
                   rdfs:label "reported in country"@en .


#################################################################
#    Data properties
#################################################################

###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#actionDate
:actionDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :FieldSafetyCorrectiveAction ;
            rdfs:range xsd:date ;
            rdfs:comment "Date on which the field safety corrective action started."@en ;
            rdfs:label "action date"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#authorizationNumber
:authorizationNumber rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Manufacturer ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Manufacturer authorization number."@en ;
                     rdfs:label "authorization number"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#closureDate
:closureDate rdf:type owl:DatatypeProperty ;
             rdfs:domain :FieldSafetyCorrectiveAction ;
             rdfs:range xsd:date ;
             rdfs:comment "Date on which the field safety corrective action was closed, when available."@en ;
             rdfs:label "closure date"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#contactEmail
:contactEmail rdf:type owl:DatatypeProperty ;
              rdfs:domain :Manufacturer ;
              rdfs:range xsd:string ;
              rdfs:comment "Regulatory contact email of the manufacturer."@en ;
              rdfs:label "contact email"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#correctiveActionTaken
:correctiveActionTaken rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Incident ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Boolean value indicating whether a corrective action was taken for the incident."@en ;
                       rdfs:label "corrective action taken"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#countriesAffected
:countriesAffected rdf:type owl:DatatypeProperty ;
                   rdfs:domain :FieldSafetyCorrectiveAction ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Textual description of the countries affected by the field safety corrective action."@en ;
                   rdfs:label "countries affected"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#detectionDate
:detectionDate rdf:type owl:DatatypeProperty ;
               rdfs:domain :Incident ;
               rdfs:range xsd:date ;
               rdfs:comment "Date on which the incident was detected."@en ;
               rdfs:label "detection date"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#deviceName
:deviceName rdf:type owl:DatatypeProperty ;
            rdfs:domain :MedicalDevice ;
            rdfs:range xsd:string ;
            rdfs:comment "Literal name of the medical device."@en ;
            rdfs:label "device name"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#devicesAffected
:devicesAffected rdf:type owl:DatatypeProperty ;
                 rdfs:domain :FieldSafetyCorrectiveAction ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Number or description of devices affected by the field safety corrective action. It is modelled as string because some CSV values include units such as tests."@en ;
                 rdfs:label "devices affected"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eudamedFscaReference
:eudamedFscaReference rdf:type owl:DatatypeProperty ;
                      rdfs:domain :FieldSafetyCorrectiveAction ;
                      rdfs:range xsd:string ;
                      rdfs:comment "EUDAMED-like reference identifier for the field safety corrective action."@en ;
                      rdfs:label "EUDAMED FSCA reference"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eudamedIncidentReference
:eudamedIncidentReference rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Incident ;
                          rdfs:range xsd:string ;
                          rdfs:comment "EUDAMED-like reference identifier for the incident."@en ;
                          rdfs:label "EUDAMED incident reference"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eudamedSrn
:eudamedSrn rdf:type owl:DatatypeProperty ;
            rdfs:domain :Manufacturer ;
            rdfs:range xsd:string ;
            rdfs:comment "Single Registration Number used in EUDAMED-like contexts."@en ;
            rdfs:label "EUDAMED SRN"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#eventDate
:eventDate rdf:type owl:DatatypeProperty ;
           rdfs:domain :Incident ;
           rdfs:range xsd:date ;
           rdfs:comment "Date on which the incident occurred."@en ;
           rdfs:label "event date"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#fscaDescription
:fscaDescription rdf:type owl:DatatypeProperty ;
                 rdfs:domain :FieldSafetyCorrectiveAction ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Textual description of the field safety corrective action."@en ;
                 rdfs:label "FSCA description"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#imdrfCode
:imdrfCode rdf:type owl:DatatypeProperty ;
           rdfs:domain :Risk ;
           rdfs:range xsd:string ;
           rdfs:comment "IMDRF-inspired risk code."@en ;
           rdfs:label "IMDRF code"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#incidentDescription
:incidentDescription rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Incident ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Textual description of the reported incident."@en ;
                     rdfs:label "incident description"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#intendedPurpose
:intendedPurpose rdf:type owl:DatatypeProperty ;
                 rdfs:domain :MedicalDevice ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Intended medical purpose of the device."@en ;
                 rdfs:label "intended purpose"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isActive
:isActive rdf:type owl:DatatypeProperty ;
          rdfs:domain :MedicalDevice ;
          rdfs:range xsd:boolean ;
          rdfs:comment "Boolean value indicating whether the device is active."@en ;
          rdfs:label "is active"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isIVD
:isIVD rdf:type owl:DatatypeProperty ;
       rdfs:domain :MedicalDevice ;
       rdfs:range xsd:boolean ;
       rdfs:comment "Boolean value indicating whether the device is an in vitro diagnostic device."@en ;
       rdfs:label "is IVD"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isImplantable
:isImplantable rdf:type owl:DatatypeProperty ;
               rdfs:domain :MedicalDevice ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Boolean value indicating whether the device is implantable."@en ;
               rdfs:label "is implantable"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#isReusable
:isReusable rdf:type owl:DatatypeProperty ;
            rdfs:domain :MedicalDevice ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Boolean value indicating whether the device is reusable."@en ;
            rdfs:label "is reusable"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#manufacturerName
:manufacturerName rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Manufacturer ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Name of the manufacturer."@en ;
                  rdfs:label "manufacturer name"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#outcome
:outcome rdf:type owl:DatatypeProperty ;
         rdfs:domain :Incident ;
         rdfs:range xsd:string ;
         rdfs:comment "Clinical, technical or regulatory outcome reported for an incident."@en ;
         rdfs:label "outcome"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#patientAge
:patientAge rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:integer ;
            rdfs:comment "Age of the patient involved in the incident, when available."@en ;
            rdfs:label "patient age"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#patientSex
:patientSex rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:string ;
            rdfs:comment "Sex of the patient involved in the incident, when available."@en ;
            rdfs:label "patient sex"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#reportDate
:reportDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:date ;
            rdfs:comment "Date on which the incident was reported."@en ;
            rdfs:label "report date"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#riskName
:riskName rdf:type owl:DatatypeProperty ;
          rdfs:domain :Risk ;
          rdfs:range xsd:string ;
          rdfs:comment "Human-readable name of the risk."@en ;
          rdfs:label "risk name"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#scope
:scope rdf:type owl:DatatypeProperty ;
       rdfs:domain :FieldSafetyCorrectiveAction ;
       rdfs:range xsd:string ;
       rdfs:comment "Scope of the field safety corrective action, such as affected lots, models or versions."@en ;
       rdfs:label "scope"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#udiDi
:udiDi rdf:type owl:DatatypeProperty ;
       rdfs:domain :MedicalDevice ;
       rdfs:range xsd:string ;
       rdfs:comment "Unique Device Identification Device Identifier."@en ;
       rdfs:label "UDI-DI"@en .


#################################################################
#    Classes
#################################################################

###  http://schema.org/MedicalDevice
<http://schema.org/MedicalDevice> rdf:type owl:Class ;
                                  rdfs:comment "External class from schema.org representing a medical device. Used as superclass of the local MedicalDevice class."@en ;
                                  rdfs:label "Medical Device"@en .


###  http://www.w3.org/2003/11/swrl#Imp
<http://www.w3.org/2003/11/swrl#Imp> rdf:type owl:Class ;
                                     rdfs:comment "SWRL vocabulary class representing an implication rule. Declared here to satisfy OWL class typing requirements."@en ;
                                     rdfs:label "SWRL Implication"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class ;
                                              rdfs:comment "External class from SKOS representing a concept in a controlled vocabulary. Used as superclass of ControlledVocabularyConcept."@en ;
                                              rdfs:label "Concept"@en .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class ;
                                  rdfs:comment "External class from PROV-O representing an agent that can act. Used as superclass of the local CompetentAuthority class."@en ;
                                  rdfs:label "Agent"@en .


###  http://xmlns.com/foaf/0.1/Organization
<http://xmlns.com/foaf/0.1/Organization> rdf:type owl:Class ;
                                         rdfs:comment "External class from FOAF representing an organization. Used as superclass of the local Manufacturer class."@en ;
                                         rdfs:label "Organization"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActionStatus
:ActionStatus rdf:type owl:Class ;
              rdfs:subClassOf :ControlledVocabularyConcept ;
              rdfs:comment "Controlled concept describing whether a field safety corrective action is open or closed."@en ;
              rdfs:label "Action status"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActiveDevice
:ActiveDevice rdf:type owl:Class ;
              rdfs:subClassOf :MedicalDevice ;
              rdfs:comment "A device that depends on a source of energy for its operation."@en ;
              rdfs:label "Active device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ActiveImplant
:ActiveImplant rdf:type owl:Class ;
               rdfs:subClassOf :ActiveDevice ,
                               :ImplantableDevice ;
               rdfs:comment "An implantable device that depends on a source of energy for its operation."@en ;
               rdfs:label "Active implant"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CompetentAuthority
:CompetentAuthority rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ,
                                    :MedicalDeviceRiskEntity ;
                    rdfs:comment "Regulatory authority responsible for medical device oversight in a country."@en ;
                    rdfs:label "Competent authority"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ContaminationRisk
:ContaminationRisk rdf:type owl:Class ;
                   rdfs:subClassOf :Risk ;
                   rdfs:comment "Risk related to contamination of reagents or medical products."@en ;
                   rdfs:label "Contamination risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ControlledVocabularyConcept
:ControlledVocabularyConcept rdf:type owl:Class ;
                             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ,
                                             :MedicalDeviceRiskEntity ;
                             rdfs:comment "A controlled concept used to normalize categorical values from the CSV files."@en ;
                             rdfs:label "Controlled vocabulary concept"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CorrectedIncident
:CorrectedIncident rdf:type owl:Class ;
                   rdfs:subClassOf :Incident ;
                   rdfs:comment "An incident for which a corrective action has been taken or is associated."@en ;
                   rdfs:label "Corrected incident"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf :ControlledVocabularyConcept ;
         rdfs:comment "Country related to a manufacturer, reported incident or corrective action scope."@en ;
         rdfs:label "Country"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#CybersecurityRisk
:CybersecurityRisk rdf:type owl:Class ;
                   rdfs:subClassOf :Risk ;
                   rdfs:comment "Risk related to exploitable cybersecurity vulnerabilities."@en ;
                   rdfs:label "Cybersecurity risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#DiagnosticRisk
:DiagnosticRisk rdf:type owl:Class ;
                rdfs:subClassOf :Risk ;
                rdfs:comment "Risk related to incorrect diagnostic results."@en ;
                rdfs:label "Diagnostic risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#FieldSafetyCorrectiveAction
:FieldSafetyCorrectiveAction rdf:type owl:Class ;
                             rdfs:subClassOf :MedicalDeviceRiskEntity ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :addressesIncident ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass :Incident
                                             ] ;
                             rdfs:comment "A field safety corrective action, such as a recall, safety alert, user notice or in-situ correction, associated with an incident."@en ;
                             rdfs:label "Field safety corrective action"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#IVDDevice
:IVDDevice rdf:type owl:Class ;
           rdfs:subClassOf :MedicalDevice ;
           owl:disjointWith :MDRDevice ;
           rdfs:comment "An in vitro diagnostic medical device regulated under the In Vitro Diagnostic Regulation."@en ;
           rdfs:label "IVD device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ImplantableActiveDevice
:ImplantableActiveDevice rdf:type owl:Class ;
                         rdfs:subClassOf :ActiveDevice ,
                                         :ImplantableDevice ;
                         rdfs:comment "A device that is both implantable and active."@en ;
                         rdfs:label "Implantable active device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ImplantableDevice
:ImplantableDevice rdf:type owl:Class ;
                   rdfs:subClassOf :MedicalDevice ;
                   rdfs:comment "A device intended to be totally or partially introduced into the human body."@en ;
                   rdfs:label "Implantable device"@en ;
                   rdfs:seeAlso <https://dbpedia.org/resource/Implant_(medicine)> .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InSituCorrection
:InSituCorrection rdf:type owl:Class ;
                  rdfs:subClassOf :FieldSafetyCorrectiveAction ;
                  rdfs:comment "A corrective action performed in the field without removing the device from use."@en ;
                  rdfs:label "In-situ correction"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InVitroDiagnosticDevice
:InVitroDiagnosticDevice rdf:type owl:Class ;
                         rdfs:subClassOf :IVDDevice ;
                         rdfs:comment "A device intended for the examination of specimens derived from the human body for diagnostic purposes."@en ;
                         rdfs:label "In vitro diagnostic device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Incident
:Incident rdf:type owl:Class ;
          rdfs:subClassOf :MedicalDeviceRiskEntity ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :concernsDevice ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :MedicalDevice
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :involvesRisk ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Risk
                          ] ;
          rdfs:comment "A reported event associated with a medical device, a risk and an outcome."@en ;
          rdfs:label "Incident"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InfectionRisk
:InfectionRisk rdf:type owl:Class ;
               rdfs:subClassOf :Risk ;
               rdfs:comment "Risk related to infection associated with a device."@en ;
               rdfs:label "Infection risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InjuryRisk
:InjuryRisk rdf:type owl:Class ;
            rdfs:subClassOf :Risk ;
            rdfs:comment "Risk related to patient injury or harm."@en ;
            rdfs:label "Injury risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#InterferenceRisk
:InterferenceRisk rdf:type owl:Class ;
                  rdfs:subClassOf :Risk ;
                  rdfs:comment "Risk related to electromagnetic or imaging interference."@en ;
                  rdfs:label "Interference risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MDRDevice
:MDRDevice rdf:type owl:Class ;
           rdfs:subClassOf :MedicalDevice ;
           rdfs:comment "A medical device regulated under the Medical Device Regulation."@en ;
           rdfs:label "MDR device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MalfunctionRisk
:MalfunctionRisk rdf:type owl:Class ;
                 rdfs:subClassOf :Risk ;
                 rdfs:comment "Risk related to device malfunction or failure."@en ;
                 rdfs:label "Malfunction risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Manufacturer
:Manufacturer rdf:type owl:Class ;
              rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization> ,
                              :MedicalDeviceRiskEntity ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasManufacturerCountry ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Country
                              ] ;
              rdfs:comment "An organization responsible for manufacturing or placing a medical device on the market."@en ;
              rdfs:label "Manufacturer"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MaterialRisk
:MaterialRisk rdf:type owl:Class ;
              rdfs:subClassOf :Risk ;
              rdfs:comment "Risk related to material wear, corrosion, particles or toxicity."@en ;
              rdfs:label "Material risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDevice
:MedicalDevice rdf:type owl:Class ;
               rdfs:subClassOf <http://schema.org/MedicalDevice> ,
                               :MedicalDeviceRiskEntity ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasManufacturer ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Manufacturer
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasRiskClass ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :RiskClass
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :regulatedUnder ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :RegulatoryFramework
                               ] ;
               rdfs:comment "A medical device or in vitro diagnostic device represented in the catalogue and regulated under MDR or IVDR."@en ;
               rdfs:label "Medical device"@en ;
               rdfs:seeAlso <http://schema.org/MedicalDevice> ,
                            <https://dbpedia.org/resource/Medical_device> .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#MedicalDeviceRiskEntity
:MedicalDeviceRiskEntity rdf:type owl:Class ;
                         rdfs:comment "Root class for all local entities defined in the medical device risk ontology."@en ;
                         rdfs:label "Medical device risk entity"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#NearMissIncident
:NearMissIncident rdf:type owl:Class ;
                  rdfs:subClassOf :Incident ;
                  owl:disjointWith :SeriousIncident ;
                  rdfs:comment "An incident that did not result in harm but could have led to an adverse outcome."@en ;
                  rdfs:label "Near-miss incident"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#PacemakerDevice
:PacemakerDevice rdf:type owl:Class ;
                 rdfs:subClassOf :ActiveImplant ;
                 rdfs:comment "An active implantable device used for cardiac pacing."@en ;
                 rdfs:label "Pacemaker device"@en ;
                 rdfs:seeAlso <https://dbpedia.org/resource/Artificial_cardiac_pacemaker> .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ProbabilityLevel
:ProbabilityLevel rdf:type owl:Class ;
                  rdfs:subClassOf :ControlledVocabularyConcept ;
                  rdfs:comment "Controlled concept describing the probability of a risk."@en ;
                  rdfs:label "Probability level"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RadiationRisk
:RadiationRisk rdf:type owl:Class ;
               rdfs:subClassOf :Risk ;
               rdfs:comment "Risk related to unintended or excessive radiation exposure."@en ;
               rdfs:label "Radiation risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Recall
:Recall rdf:type owl:Class ;
        rdfs:subClassOf :FieldSafetyCorrectiveAction ;
        rdfs:comment "A field safety corrective action involving removal, replacement or recall of affected devices."@en ;
        rdfs:label "Recall"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RegulatoryFramework
:RegulatoryFramework rdf:type owl:Class ;
                     rdfs:subClassOf :ControlledVocabularyConcept ;
                     rdfs:comment "Regulatory framework applicable to a device, such as MDR or IVDR."@en ;
                     rdfs:label "Regulatory framework"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#ReusableDevice
:ReusableDevice rdf:type owl:Class ;
                rdfs:subClassOf :MedicalDevice ;
                rdfs:comment "A device designed to be reused after appropriate reprocessing or maintenance."@en ;
                rdfs:label "Reusable device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf :MedicalDeviceRiskEntity ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasProbability ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :ProbabilityLevel
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasSeverity ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :SeverityLevel
                      ] ;
      rdfs:comment "A risk identified for a medical device according to a controlled risk terminology, such as IMDRF-inspired coding."@en ;
      rdfs:label "Risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskCategory
:RiskCategory rdf:type owl:Class ;
              rdfs:subClassOf :ControlledVocabularyConcept ;
              rdfs:comment "High-level category used to group risks, such as Device Failure or Patient Harm."@en ;
              rdfs:label "Risk category"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskClass
:RiskClass rdf:type owl:Class ;
           rdfs:subClassOf :ControlledVocabularyConcept ;
           rdfs:comment "Regulatory risk class assigned to a device under MDR or IVDR."@en ;
           rdfs:label "Risk class"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#RiskType
:RiskType rdf:type owl:Class ;
          rdfs:subClassOf :ControlledVocabularyConcept ;
          rdfs:comment "Specific type of risk, such as MalfunctionRisk, InjuryRisk or DiagnosticRisk."@en ;
          rdfs:label "Risk type"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SafetyAlert
:SafetyAlert rdf:type owl:Class ;
             rdfs:subClassOf :FieldSafetyCorrectiveAction ;
             rdfs:comment "A field safety corrective action based on a safety communication or alert."@en ;
             rdfs:label "Safety alert"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SelfTestDevice
:SelfTestDevice rdf:type owl:Class ;
                rdfs:subClassOf :IVDDevice ;
                rdfs:comment "An in vitro diagnostic device intended to be used by lay persons or patients."@en ;
                rdfs:label "Self-test device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SeriousIncident
:SeriousIncident rdf:type owl:Class ;
                 rdfs:subClassOf :Incident ;
                 rdfs:comment "An incident that resulted, might have resulted or may result in serious patient harm or device malfunction."@en ;
                 rdfs:label "Serious incident"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SeverityLevel
:SeverityLevel rdf:type owl:Class ;
               rdfs:subClassOf :ControlledVocabularyConcept ;
               rdfs:comment "Controlled concept describing the severity of a risk."@en ;
               rdfs:label "Severity level"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SingleUseDevice
:SingleUseDevice rdf:type owl:Class ;
                 rdfs:subClassOf :MedicalDevice ;
                 rdfs:comment "A device intended to be used once and not reprocessed for reuse."@en ;
                 rdfs:label "Single-use device"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#SoftwareRisk
:SoftwareRisk rdf:type owl:Class ;
              rdfs:subClassOf :Risk ;
              rdfs:comment "Risk related to software malfunction or incorrect software behavior."@en ;
              rdfs:label "Software risk"@en .


###  https://lvlupcodex.github.io/medical-device-risk-ontology/ontology#UserNotice
:UserNotice rdf:type owl:Class ;
            rdfs:subClassOf :FieldSafetyCorrectiveAction ;
            rdfs:comment "A notice issued to users or healthcare professionals about safe use of a device."@en ;
            rdfs:label "User notice"@en .


