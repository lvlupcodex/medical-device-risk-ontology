[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#hasRuleText> "Incident(?i), hasCorrectiveAction(?i, ?f) -> CorrectedIncident(?i)"@en
] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#hasRuleText> "MedicalDevice(?d), regulatedUnder(?d, MDR) -> MDRDevice(?d)"@en
 ] .

